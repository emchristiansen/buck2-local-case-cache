# NativeLink client settings for the engine build, mirroring Muninn's
# recv-v2/ws/.buckconfig:13-20. The endpoint is the workstation's NativeLink
# service; this file only declares where a NativeLink run sends actions.
[buck2_re_client]
engine_address = grpc://127.0.0.1:50051
action_cache_address = grpc://127.0.0.1:50051
cas_address = grpc://127.0.0.1:50051
tls = false

[buck2]
digest_algorithms = SHA256

[buck2_resource_control]
status = off
status_if_min_daemon_cgroup_version = 2
