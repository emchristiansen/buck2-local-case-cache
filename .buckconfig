[cells]
gh_facebook_buck2 = .
gh_facebook_buck2_shims_meta = shim

[cell_aliases]
root = gh_facebook_buck2

[oss]
internal_cell = fbcode
stripped_root_dirs = buck2

[project]
# `prelude` (the engine's own prelude source) is ignored because the decl
# edition's prelude cell is Muninn's patched prelude (.buckconfig.d/common.buckconfig);
# the directory's BUCK files only load as the prelude cell itself.
ignore = \
    app/buck2_explain, \
    app/buck2_trailcam, \
    app_dep_graph_rules, \
    examples, \
    integrations/rust-project/tests, \
    tests, \
    .jj, \
    .git, \
    target, \
    prelude

[rust]
default_edition = 2024
