[cells]
gh_facebook_buck2 = .
gh_facebook_buck2_shims_meta = shim

[cell_aliases]
root = gh_facebook_buck2

[oss]
internal_cell = fbcode
stripped_root_dirs = buck2

[project]
# `prelude` (the engine's own prelude source) is ignored: its BUCK files load only as the
# prelude cell itself, which is that directory by default and Muninn's patched prelude in the
# explicit NativeLink mode (mode/nativelink.buckconfig). It is ignored in both, because buck2
# reads `project.ignore` only when the daemon starts and a `--config-file` cannot set it.
ignore = \
    app/buck2_explain, \
    app/buck2_trailcam, \
    app_dep_graph_rules, \
    examples, \
    integrations/rust-project/tests, \
    tests, \
    .jj, \
    .git, \
    target, \
    prelude

[rust]
default_edition = 2024
