load("@prelude//git:git_fetch.bzl", "git_fetch_tool")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("build_infra")

source_listing()

prelude = native

# The fetch tool is eligible only on the platform advertising its immutable runtime.
prelude.constraint_setting(
    name = "fetch_runtime",
    visibility = ["PUBLIC"],
)

prelude.constraint_value(
    name = "fetch_runtime_available",
    constraint_setting = ":fetch_runtime",
    visibility = ["PUBLIC"],
)

git_fetch_tool(
    name = "git_fetch",
    main = "git_fetch.py",
    runtime_manifest = "git-fetch-runtime.json",
    target_compatible_with = [":fetch_runtime_available"],
    visibility = ["PUBLIC"],
)

# Type checking target for Python tool scripts
prelude.python_library(
    name = "scripts-typing",
    srcs = [
        "git_fetch.py",
    ],
    typing = True,
)
