oncall("open_source")

# This package is the explicit NativeLink mode's toolchains cell (nix_toolchains), which that mode
# selects as `toolchains`. It loads the patched prelude's providers, so it evaluates only with that
# prelude, and it refuses to evaluate outside the mode.
require_nativelink_mode("shim/nix, the toolchains cell nix_toolchains,")

configuration_alias(
    name = "none",
    actual = "prelude//:none",
    visibility = ["PUBLIC"],
)

# NativeLink engine build (decl edition): the C/C++, Rust and Python toolchains
# name exact Nix store tools, each with :nix-manifest.json as a hidden
# input, following Muninn's toolchains/BUCK (recv-v2/ws, sha256 a446406f...).
# The upstream system_* C/C++, Python and Rust toolchains, which run whatever
# gcc/python3/rustc the executing host has on PATH, are replaced. Go, Haskell
# and OCaml stay system toolchains: no target of the engine build or of its
# unit tests uses them.

export_file(
    name = "nix-manifest.json",
    src = "nix-manifest.json",
    mode = "reference",
    visibility = ["PUBLIC"],
)

pinned_executable(
    name = "rust_linker",
    nix_manifest = ":nix-manifest.json",
    path = PINNED_TOOLS["rust_linker"]["path"],
    visibility = ["PUBLIC"],
)

engine_pinned_rust_toolchain(
    name = "rust",
    default_edition = "2024",
    linker = ":rust_linker",
    nix_manifest = ":nix-manifest.json",
    # Unset leaves each test unbounded, as libtest and `buck2 test` are.
    per_test_timeout_seconds = read_config("test", "per_test_timeout_seconds", None),
    test_process_runner = ":libtest_process_runner",
    visibility = ["PUBLIC"],
)

# Muninn's libtest process runner, byte-for-byte the runner of the FC9 candidate composed with
# CaseRuns-R1 (toolchains/: libtest_process_runner_main.py, libtest_process_runner/*.py,
# process_environment/*.py; Python stdlib only, run by the pinned interpreter). Its
# `--raw-one-case` is the transport of the prelude's remote per-case route, and its
# `--spawn-inputs-witness` writes the spawn-inputs record the FC9 prelude's remote case parser
# requires: the FC9 prelude's rust_test passes that flag, so an older runner refuses its commands.
# The Muninn prelude's portable rust_test contract (rust/rust_binary.bzl
# _rust_test_re_executors) requires it for the `nativelink_test_result_reuse`
# profile: it lists and runs each libtest case in its own process, worker-side,
# with HOME and TMPDIR made project-relative.
python_bootstrap_library(
    name = "process_environment",
    srcs = glob(["process_environment/*.py"]),
)

python_bootstrap_library(
    name = "libtest_process_runner_modules",
    srcs = glob(["libtest_process_runner/*.py"]),
)

python_bootstrap_binary(
    name = "libtest_process_runner",
    main = "libtest_process_runner_main.py",
    visibility = ["PUBLIC"],
    deps = [":libtest_process_runner_modules", ":process_environment"],
)

pinned_executable(
    name = "python_interpreter",
    nix_manifest = ":nix-manifest.json",
    path = PINNED_TOOLS["python"]["path"],
    visibility = ["PUBLIC"],
)

python_bootstrap_toolchain(
    name = "python_bootstrap",
    interpreter = ":python_interpreter",
    visibility = ["PUBLIC"],
)

python_toolchain(
    name = "python",
    extension_linker_flags = PINNED_PYTHON_EXTENSION_LINKER_FLAGS,
    interpreter = ":python_interpreter",
    visibility = ["PUBLIC"],
)

# The Muninn-patched prelude's http_archive extracts through this pinned shell
# (prelude//http_archive:exec_deps.bzl defaults to toolchains//:archive_shell);
# every non-vendored crate archive in third-party/rust/BUCK goes through it.
pinned_executable(
    name = "archive_shell",
    nix_manifest = ":nix-manifest.json",
    path = PINNED_TOOLS["bash"]["path"],
    path_env = PINNED_ARCHIVE_NIX_PATH,
    visibility = ["PUBLIC"],
)

[
    pinned_executable(
        name = tool,
        nix_manifest = ":nix-manifest.json",
        path = PINNED_TOOLS[tool]["path"],
        visibility = ["PUBLIC"],
    )
    for tool in ["cc", "ar", "as", "ld", "llvm_link", "nm", "objcopy", "objdump", "ranlib", "strip"]
]

# The pinned clang as a file artifact, for test environments that take a compiler's
# location: shims.bzl maps gazebo/hmap's internal `llvm-21-bin/clang` here.
pinned_tool_launcher(
    name = "clang",
    nix_manifest = ":nix-manifest.json",
    path = PINNED_TOOLS["clang"]["path"],
    visibility = ["PUBLIC"],
)

pinned_executable(
    name = "cxx_compiler",
    nix_manifest = ":nix-manifest.json",
    path = PINNED_TOOLS["cxx"]["path"],
    visibility = ["PUBLIC"],
)

pinned_cxx_tools(
    name = "cxx_tools",
    ar = ":ar",
    cc = ":cc",
    cxx = ":cxx_compiler",
    linker_type = "gnu",
    visibility = ["PUBLIC"],
)

cxx_tools_info_toolchain(
    name = "cxx_template",
    cxx_flags = ["-std=c++20"],
    cxx_tools_info = ":cxx_tools",
    link_flags = PINNED_CXX_LINK_FLAGS,
    link_style = "static",
)

pinned_cxx_toolchain(
    name = "cxx",
    llvm_link = ":llvm_link",
    nm = ":nm",
    objcopy = ":objcopy",
    objdump = ":objdump",
    ranlib = ":ranlib",
    strip = ":strip",
    template = ":cxx_template",
    visibility = ["PUBLIC"],
)

# Muninn's prelude (87765b7b) makes clippy_configuration's `toml_merge_tool`
# mandatory; the merged tree's own prelude made it optional, and this shim's
# clippy_configuration wrapper (build_defs/clippy_configuration.bzl) relied on
# that. The engine Rust toolchain declares no clippy.toml, so the prelude never
# creates the merge action and this tool never runs; if it ever did, it fails.
refusing_tool(
    name = "clippy_toml_merge_undeclared",
    message = "clippy.toml merge: no toml_merge_tool is declared for the engine Rust toolchain",
    nix_manifest = ":nix-manifest.json",
    visibility = ["PUBLIC"],
)

# protoc and the protobuf well-known types for the prost build scripts
# (shims.bzl _rust_protobuf_library: PROTOC, PROTOC_INCLUDE), declared as
# pinned tools: nixpkgs protobuf_21 (21.12) from the nixpkgs-compiler set,
# replacing the prebuilt protoc 21.4 zip whose binary needs the FHS loader
# /lib64/ld-linux-x86-64.so.2, which the NativeLink v2 worker does not provide.
# The include root is copied into a Buck output by W's pinned_directory_copy
# (toolchains/pinned_directory.bzl and pinned_directory_copy.py, byte-for-byte
# here), so `$(location)` names a real directory artifact of regular files.
# shim//third-party/proto:{protoc,google_protobuf} alias these.
pinned_executable(
    name = "protoc",
    nix_manifest = ":nix-manifest.json",
    path = PINNED_TOOLS["protoc"]["path"],
    visibility = ["PUBLIC"],
)

pinned_directory_copy(
    name = "protobuf_well_known_types",
    nix_manifest = ":nix-manifest.json",
    path = PINNED_TOOLS["protobuf_proto"]["path"],
    script = "pinned_directory_copy.py",
    subpaths = {"include": "directory"},
    visibility = ["PUBLIC"],
)

# As in Muninn's toolchains/BUCK: the prelude's default C++ toolchain dependency
# names this label in a select branch no configuration matches, so it must exist.
toolchain_alias(
    name = "cxx_no_default_deps",
    actual = ":cxx",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

system_go_toolchain(
