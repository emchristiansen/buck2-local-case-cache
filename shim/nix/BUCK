system_haskell_toolchain(
    name = "haskell",
    visibility = ["PUBLIC"],
)

system_ocaml_toolchain(
    name = "ocaml",
    visibility = ["PUBLIC"],
)

# Remote test profiles, verbatim from Muninn's toolchains/BUCK:133-151. The
# engine unit tests (shim rust_library -> `<name>-unittest`) name
# `nativelink_test_result_reuse`: the worker capabilities plus
# `muninn-test-runtime=linux-unprivileged-v2`, local execution forbidden.
remote_test_execution_toolchain(
    name = "remote_test_execution",
    default_profile = read_config("buck2", "remote_test_profile", default = None),
    profiles = {
        "nativelink_r4": {
            "capabilities": REMOTE_EXECUTION_PROPERTIES,
            "local_enabled": False,
            "remote_cache_enabled": False,
            "use_case": "buck2-default",
        },
        "nativelink_test_result_reuse": {
            "capabilities": REMOTE_EXECUTION_PROPERTIES | MUNINN_TEST_RUNTIME,
            "local_enabled": False,
            "remote_cache_enabled": True,
            "use_case": "buck2-default",
        },
    },
    visibility = ["PUBLIC"],
)

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)
