load(":python_test.bzl", "provider_artifact_pair_test", "provider_pair_test", "python_test")

python_test(
    name = "trivial_pass",
    script = "import sys; sys.exit(0)",
)

python_test(
    name = "check_env",
    script = "import os; assert os.environ['TEST_VAR'] == 'TEST_VALUE'",
)

python_test(
    name = "timeout",
    script = "import time; time.sleep(60)",
)

python_test(
    name = "internal_default_pass",
    internal = True,
    script = "import sys; sys.exit(0)",
)

python_test(
    name = "internal_cache_request",
    internal = True,
    local_case_cache = True,
    script = "import sys; sys.exit(0)",
)

provider_pair_test(
    name = "provider_pair",
    expected = read_config("provider_pair", "expected", ""),
)

provider_artifact_pair_test(
    name = "provider_artifact_pair",
)
